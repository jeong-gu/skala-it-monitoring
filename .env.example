# LangSmith 원문 추적 기본 비활성 — 키와 .env는 Git에 커밋하지 않음
# 이 저장소에서는 ../../../../_통합개념_실습/LANGSMITH/base-langsmith/.env를
# 복사해 써도 된다 (run.sh가 .env가 없으면 자동 복사).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=capstone-all-total
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LLM_BACKEND=openai 메인 LLM에 사용 — 실제 OpenAI 계정에 과금되는
# 원격 API 키다. 절대 커밋하지 말고, 본인 계정의 유효한 키를 .env에만 넣을 것.
OPENAI_API_KEY=
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o

# 같은 로컬 FastAPI의 명령어 시나리오 API (기본 8100, 외부 주소 사용 안 함)
# LOCAL_MONITORING_API_URL=http://127.0.0.1:8100

# 공식 매뉴얼 RAG — 최초 수집/색인은 doc/remediation.md 참조
# MANUAL_EMBED_MODEL=bge-m3
# MANUAL_OLLAMA_URL=http://127.0.0.1:11434
# MANUAL_INDEX_DIR=/absolute/path/to/data/manual_index

# OpenAI 메인 LLM / 로컬 BGE 임베딩 — 키 입력 후 서버 재시작
LLM_BACKEND=openai
SUPERVISOR_VERSION=v2
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o-mini
MANUAL_EMBED_MODEL=bge-m3
MANUAL_OLLAMA_URL=http://127.0.0.1:11434
LANGSMITH_TRACING=false

# Whole v2 /chat and SSE request budget. Cancellation stops new workflow work;
# an already running synchronous provider HTTP request may finish in background.
WORKFLOW_TIMEOUT_SECONDS=120
